{"success":true,"data":{"id":32,"info1_content":"<div class=\"font-montserrat max-w-5xl  \"><p class=\"font-montserrat font-medium text-base text-justify md:text-start pb-5\" style=\"text-align: center;\"><b>C<font size=\"3\">abaña La Ribera</font></b><font size=\"3\"> presenta su <b>2do Gran Remate San Rafael de&nbsp;</b><b style=\"letter-spacing: 0.00938em;\">Velasco</b><span style=\"letter-spacing: 0.00938em;\">, una propuesta que reúne </span><b style=\"letter-spacing: 0.00938em;\">toros y vaquillas premium&nbsp;</b><span style=\"letter-spacing: 0.00938em;\">seleccionados bajo una visión clara: genética, calidad y&nbsp;</span></font><span style=\"font-size: medium; letter-spacing: 0.00938em;\">proyección.</span></p><p class=\"font-montserrat font-medium text-base text-justify md:text-start pb-5\" style=\"text-align: center;\"><font size=\"3\"><br></font></p><p class=\"font-montserrat font-medium text-base text-justify md:text-start pb-5\" style=\"text-align: center;\"><font size=\"3\">Un encuentro donde cada <b>ejemplar </b>ha sido elegido para&nbsp;<span style=\"letter-spacing: 0.00938em;\">representar el </span><b style=\"letter-spacing: 0.00938em;\">trabajo</b><span style=\"letter-spacing: 0.00938em;\">, la dedicación y el </span><b style=\"letter-spacing: 0.00938em;\">compromiso </b><span style=\"letter-spacing: 0.00938em;\">detrás de&nbsp;</span><span style=\"letter-spacing: 0.00938em;\">una </span><b style=\"letter-spacing: 0.00938em;\">genética </b><span style=\"letter-spacing: 0.00938em;\">construida con propósito.</span></font></p><p class=\"font-montserrat font-medium text-base text-justify md:text-start pb-5\" style=\"text-align: center;\"><font size=\"3\"><br></font></p><p class=\"font-montserrat font-medium text-base text-justify md:text-start pb-5\" style=\"text-align: center;\"><font size=\"3\">Porque cuando la genética es excepcional, merece un escenario&nbsp;<span style=\"letter-spacing: 0.00938em;\">a la altura.</span></font></p><p class=\"font-montserrat font-medium text-base text-justify md:text-start pb-5\" style=\"text-align: center;\"><font size=\"3\"><br></font></p><p class=\"font-montserrat font-medium text-base text-justify md:text-start pb-5\" style=\"text-align: center;\"><b><font size=\"3\">23 DE OCTUBRE · 12:00 HRS</font></b></p><p class=\"font-montserrat font-medium text-base text-justify md:text-start pb-5\" style=\"text-align: center;\"><font size=\"3\"><br></font></p><p class=\"font-montserrat font-medium text-base text-justify md:text-start pb-5\" style=\"text-align: center;\"><font size=\"3\">Feria Ganadera San Rafael de Velasco</font></p></div>","image_desktop_url":"https://res.cloudinary.com/daagrnuak/image/upload/v1792011301/proy_cabana_laribera/images/info1/h1mr6c3zwawicybvyhhi.webp","image_mobile_url":"https://res.cloudinary.com/daagrnuak/image/upload/v1792011302/proy_cabana_laribera/images/info1/xdyty6fpk2zroxmkjb3n.webp","presentational_desktop_url":"https://res.cloudinary.com/daagrnuak/image/upload/v1792437993/proy_cabana_laribera/images/info1/bf3fl4emij0em8v601bb.webp","presentational_mobile_url":"https://res.cloudinary.com/daagrnuak/image/upload/v1792437995/proy_cabana_laribera/images/info1/zmmqbvtvhrulibrgwszc.webp","cinta_desktop_url":"https://res.cloudinary.com/daagrnuak/image/upload/v1792437996/proy_cabana_laribera/images/info1/q4a59pphxvipaysyoobr.webp","cinta_mobile_url":"https://res.cloudinary.com/daagrnuak/image/upload/v1792437997/proy_cabana_laribera/images/info1/ak3hikzgli6fsrk2ng5k.webp","text_color":"#ffffff","header_bg_color":"#ffa500","header_text_color":"#ffffff"}}